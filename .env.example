# Copier en .env et remplacer chaque valeur. .env n'est jamais commité.
# Secrets (POSTGRES_USER, POSTGRES_PASSWORD, APP_DB_PASSWORD, clés d'API) : un fichier
# /run/secrets/cdg/<NOM>, s'il existe, passe avant la variable (montage du chart, ADR 005).

# Superutilisateur PostgreSQL : migrations et administration uniquement
POSTGRES_USER=cdg_admin
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=cdg
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost   # facultatif, localhost si absent

# Mot de passe du rôle applicatif app_role (SELECT, INSERT sur audit_decisions).
# Obligatoire : sans lui, le script d'init échoue et aucune migration n'est appliquée.
APP_DB_PASSWORD=a-remplacer

# Aucune télémétrie externe par défaut (hébergement souverain) : langsmith, tiré par
# langchain-core, n'envoie rien tant que ce traçage reste désactivé.
LANGSMITH_TRACING=false

# Traces OpenTelemetry (ADR 008) : aucune destination par défaut, rien n'est envoyé.
# Vers le Langfuse auto-hébergé du poste (compose.observabilite.yaml) : décommenter
# CDG_TRACES. Les deux clés du projet servent à Langfuse (posées à son démarrage) et à
# l'application ; elles sont exigées dès que l'une ou l'autre s'en sert.
# CDG_TRACES=http://127.0.0.1:3100/api/public/otel
LANGFUSE_PUBLIC_KEY=pk-lf-a-remplacer
LANGFUSE_SECRET_KEY=sk-lf-a-remplacer

# Langfuse du poste (compose.observabilite.yaml), tous exigés au lancement : chaque valeur
# à générer, en hexadécimal (les mots de passe entrent dans des URL), par exemple
#   openssl rand -hex 32
LANGFUSE_POSTGRES_PASSWORD=a-remplacer
LANGFUSE_CLICKHOUSE_PASSWORD=a-remplacer
LANGFUSE_VALKEY_PASSWORD=a-remplacer
LANGFUSE_S3_ACCESS_KEY_ID=a-remplacer
LANGFUSE_S3_SECRET_ACCESS_KEY=a-remplacer
LANGFUSE_NEXTAUTH_SECRET=a-remplacer
LANGFUSE_SALT=a-remplacer
# 64 caractères hexadécimaux exactement (openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=a-remplacer
# compte de l'interface de Langfuse (http://127.0.0.1:3100) : adresse fictive
LANGFUSE_INIT_USER_EMAIL=operateur@example.org
LANGFUSE_INIT_USER_PASSWORD=a-remplacer
# Identité dans les traces : aucune par défaut ; « sub » émet le sub pseudonyme de
# l'interface authentifiée, qui s'accumulerait sans fin dans Langfuse (conservation, RGPD).
# CDG_TRACES_IDENTITE=aucune

# Cache persistant des poids du modèle d'embedding (environ 2,2 Go), hors du dépôt git.
# Chemin relatif = depuis la racine du dépôt. Remplir par : cdg.cli fetch-embedding-model
EMBEDDING_CACHE_DIR=.cache/embeddings

# Clés d'API des fournisseurs LLM (seule celle du fournisseur configuré est exigée)
MISTRAL_API_KEY=a-remplacer
# ANTHROPIC_API_KEY=a-remplacer
# Adresse de l'API de Mistral : par défaut celle du SDK (https://api.mistral.ai). Ne la
# remplacer que pour un serveur factice de test ; en production, le proxy de sortie ne
# laisse passer que l'API de Mistral (ADR 005).
# MISTRAL_SERVER_URL=
