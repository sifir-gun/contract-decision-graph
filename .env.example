# Copier en .env et remplacer chaque valeur. .env n'est jamais commité.

# Superutilisateur PostgreSQL : migrations et administration uniquement
POSTGRES_USER=cdg_admin
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=cdg
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost   # facultatif, localhost si absent

# Mot de passe du rôle applicatif app_role (SELECT, INSERT sur audit_decisions).
# Obligatoire : sans lui, le script d'init échoue et aucune migration n'est appliquée.
APP_DB_PASSWORD=a-remplacer

# Aucune télémétrie externe par défaut (hébergement souverain) : langsmith, tiré par
# langchain-core, n'envoie rien tant que ce traçage reste désactivé.
LANGSMITH_TRACING=false

# Cache persistant des poids du modèle d'embedding (environ 2,2 Go), hors du dépôt git.
# Chemin relatif = depuis la racine du dépôt. Remplir par : cdg.cli fetch-embedding-model
EMBEDDING_CACHE_DIR=.cache/embeddings

# Clés d'API des fournisseurs LLM (seule celle du fournisseur configuré est exigée)
MISTRAL_API_KEY=a-remplacer
# ANTHROPIC_API_KEY=a-remplacer
# Adresse de l'API de Mistral : par défaut celle du SDK (https://api.mistral.ai). Ne la
# remplacer que pour un serveur factice de test ; en production, le proxy de sortie ne
# laisse passer que l'API de Mistral (ADR 005).
# MISTRAL_SERVER_URL=
